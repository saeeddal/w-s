{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../../out-tsc/app",
    "types": [],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "@app/*": ["./src/app/*"],
      "@assets/*": ["./src/assets/*"],
      "@environments/*": ["./src/environments/*"],
      "@layouts/*": ["./src/app/layouts/*"],
      "@pages/*": ["./src/app/pages/*"],
      "@settings/*": ["./src/app/settings/*"],
      "@config/*": ["./src/app/settings/config/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@services/*": ["./src/app/shared/services/*"],
      "@helpers/*": ["./src/app/shared/helpers/*"],
      "@store/*": ["./src/app/shared/store/*"],
      "@ui-kit/*": ["./src/app/ui-kit/*"],
      "@pars-lib": ["./projects/pars-lib/src"],
      "@pars-lib/*": ["./projects/pars-lib/src/*"],

      "@pars-lib-style/*": ["./projects/pars-lib/styles/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
