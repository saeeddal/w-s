{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declarationMap": true,
    "types": [],
    "target": "ES2022",
    "module": "ES2022",
    "declaration": true,
    "moduleResolution": "bundler",
    "rootDir": ".",
    "sourceMap": true // ← Add this line
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/testing/*.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
