{
  "name": "n1-ws",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css}\"",
    "lint": "ng lint",
    "lint:fix": "eslint \"projects/**/*.{ts,html}\" --fix",
    "lint:fix:ts": "eslint \"projects/**/*.ts\" --fix",
    "lint:fix:html": "eslint \"projects/**/*.html\" --fix",
    "lint:fix:app": "eslint \"projects/nn_app/**/*.{ts,html}\" --fix",
    "lint:fix:lib": "eslint \"projects/pars-lib/**/*.{ts,html}\" --fix",
    "lint:fix-imports": "eslint --fix \"projects/**/*.ts\" --rule \"import/order: error\""
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@ng-select/ng-select": "^13.0.0",
    "@ngrx/operators": "^21.1.0",
    "@ngrx/signals": "^21.1.0",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "persian-date-time-picker-signal": "^1.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^22.0.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "angular-eslint": "^21.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  }
